{"id":"sh/d4fqhcvy","kind":"textbox","position":{"left":70,"top":225,"width":1146,"height":422},"text":"def ReturnToDroneBay(droneIDs):\n    entity = eveMoniker.GetEntityAccess()\n    if entity:\n        ret = entity.CmdReturnBay(droneIDs)\n        HandleMultipleCallError(droneIDs, ret, 'MultiDroneCmdResult')\n    return","style":{"fontSize":28,"typeface":"Consolas","color":"#78D5E6","alignment":"left"},"geometry":"rect","lineWidth":0},
