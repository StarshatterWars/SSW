{"id":"sh/98rytw72","kind":"textbox","name":"Text 4","position":{"left":52.8,"top":72,"width":1152,"height":48},"text":"ILSpy — .NET Decompiler","style":{"fontSize":40,"typeface":"Helvetica Neue","color":"#1A1A1A","bold":true,"alignment":"left"},"geometry":"rect"},
{"id":"sh/o7ih0r6h","kind":"textbox","name":"Text 5","position":{"left":52.8,"top":134.4,"width":1171.2,"height":76.8},"text":"Open-source decompiler and assembly browser for the .NET ecosystem. The primary free alternative to commercial tools such as .NET Reflector.","style":{"fontSize":21.33,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/72t03qp0","kind":"textbox","name":"Text 6","position":{"left":67.2,"top":244,"width":1132.8,"height":46},"text":"•  Decompiles managed IL to readable C#","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/61kzalof","kind":"textbox","name":"Text 7","position":{"left":67.2,"top":299,"width":1132.8,"height":46},"text":"•  Supports .NET Framework, .NET Core / .NET 5+, and Mono assemblies","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/ofqtgnyt","kind":"textbox","name":"Text 8","position":{"left":67.2,"top":354,"width":1132.8,"height":46},"text":"•  Interactive assembly browser with search and navigation","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/9gza9sze","kind":"textbox","name":"Text 9","position":{"left":67.2,"top":409,"width":1132.8,"height":46},"text":"•  Pair static inspection with a compatible debugger when needed","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/mdobedg3","kind":"textbox","name":"Text 10","position":{"left":67.2,"top":464,"width":1132.8,"height":46},"text":"•  Export whole assemblies or individual types/methods to source","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/nehs7iho","kind":"textbox","name":"Text 11","position":{"left":67.2,"top":519,"width":1132.8,"height":46},"text":"•  Extensible plugin architecture","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/0b6tc3yx","kind":"textbox","name":"Text 12","position":{"left":67.2,"top":574,"width":1132.8,"height":46},"text":"•  Active open-source development (ILSpy / ICSharpCode)","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"}
]}
