{"id":"sh/tkby9kzm","kind":"textbox","name":"Text 4","position":{"left":52.8,"top":72,"width":1152,"height":48},"text":"NSA Ghidra","style":{"fontSize":42.67,"typeface":"Helvetica Neue","color":"#1A1A1A","bold":true,"alignment":"left"},"geometry":"rect"},
{"id":"sh/sjix0zy1","kind":"textbox","name":"Text 5","position":{"left":52.8,"top":134.4,"width":1171.2,"height":67.2},"text":"Open-source software reverse engineering framework released by the U.S. National Security Agency in 2019.","style":{"fontSize":21.33,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/je9g3ahk","kind":"textbox","name":"Text 6","position":{"left":67.2,"top":220.8,"width":1132.8,"height":52.8},"text":"•  Supports dozens of processor architectures (x86, ARM, MIPS, PowerPC, RISC-V, etc.)","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/id0fu50z","kind":"textbox","name":"Text 7","position":{"left":67.2,"top":283.2,"width":1132.8,"height":52.8},"text":"•  High-quality decompiler producing C-like pseudocode","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/o7ydoret","kind":"textbox","name":"Text 8","position":{"left":67.2,"top":345.6,"width":1132.8,"height":52.8},"text":"•  Integrated disassembler, debugger, and symbol management","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/98rehwve","kind":"textbox","name":"Text 9","position":{"left":67.2,"top":408,"width":1132.8,"height":52.8},"text":"•  Powerful scripting in Java and Python (Ghidra scripts / PyGhidra)","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/m5gvmhwn","kind":"textbox","name":"Text 10","position":{"left":67.2,"top":470.4,"width":1132.8,"height":52.8},"text":"•  Collaborative multi-user project support","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/n6pwfmd8","kind":"textbox","name":"Text 11","position":{"left":67.2,"top":532.8,"width":1132.8,"height":52.8},"text":"•  Extensible via plugins and headless mode for automation","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"}
]}
