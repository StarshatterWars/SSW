{"id":"sh/7ytovm14","kind":"textbox","position":{"left":60,"top":235,"width":1160,"height":415},"text":"def ReturnToDroneBay(droneIDs):\n    entity = eveMoniker.GetEntityAccess()\n    if entity:\n        ret = entity.CmdReturnBay(droneIDs)\n        HandleMultipleCallError(\n            droneIDs, ret, 'MultiDroneCmdResult'\n        )\n    return","style":{"fontSize":24,"typeface":"Consolas","color":"#1F3DA8","alignment":"left"},"geometry":"rect","lineWidth":0}
