{"id":"sh/qx0v21ob","kind":"textbox","position":{"left":60,"top":235,"width":1160,"height":415},"text":"bool MiningDroneAI::Return(FMiningDroneState& Drone,\n    const FMiningDroneFrame& Frame, FText& Reason)\n{\n    if (!Authorized(Frame, Reason) || !Deployed(Drone))\n        return false;\n    Drone.State = EMiningDroneState::Returning;\n    Drone.TargetContact = INDEX_NONE;\n    Drone.bRepeatMining = false;\n    Reason = INVTEXT(\"Drone returning to its owner.\");\n    return true;\n}","style":{"fontSize":24,"typeface":"Consolas","color":"#1F3DA8","alignment":"left"},"geometry":"rect","lineWidth":0}
]}
