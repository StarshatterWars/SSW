{"id":"sh/xovqhcz2","kind":"textbox","name":"Text 4","position":{"left":52.8,"top":72,"width":1152,"height":48},"text":"AI Hallucinations & Verification","style":{"fontSize":34.67,"typeface":"Helvetica Neue","color":"#1A1A1A","bold":true,"alignment":"left"},"geometry":"rect"},
{"id":"sh/w3m9o7yh","kind":"textbox","name":"Text 5","position":{"left":52.8,"top":144,"width":57.6,"height":43.2},"text":"01","style":{"fontSize":21.33,"typeface":"Helvetica Neue","color":"#1F3DA8","bold":true,"alignment":"left"},"geometry":"rect"},
{"id":"sh/jqd8jmhs","kind":"textbox","name":"Text 6","position":{"left":124.8,"top":144,"width":1075.2,"height":62.4},"text":"LLMs can invent function purposes, variable meanings, or vulnerability claims that sound plausible.","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/ip4rqhgn","kind":"textbox","name":"Text 7","position":{"left":52.8,"top":220.8,"width":57.6,"height":43.2},"text":"02","style":{"fontSize":21.33,"typeface":"Helvetica Neue","color":"#1F3DA8","bold":true,"alignment":"left"},"geometry":"rect"},
{"id":"sh/sby90zm1","kind":"textbox","name":"Text 8","position":{"left":124.8,"top":220.8,"width":1075.2,"height":62.4},"text":"Always cross-reference agent claims against the actual disassembly, decompiler output, and dynamic behavior.","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/tc7at436","kind":"textbox","name":"Text 9","position":{"left":52.8,"top":297.6,"width":57.6,"height":43.2},"text":"03","style":{"fontSize":21.33,"typeface":"Helvetica Neue","color":"#1F3DA8","bold":true,"alignment":"left"},"geometry":"rect"},
{"id":"sh/69gry94v","kind":"textbox","name":"Text 10","position":{"left":124.8,"top":297.6,"width":1075.2,"height":62.4},"text":"Require function identities, hashes and specific operations for important claims.","style":{"fontSize":21,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/rapsrelg","kind":"textbox","name":"Text 11","position":{"left":52.8,"top":374.4,"width":57.6,"height":43.2},"text":"04","style":{"fontSize":21.33,"typeface":"Helvetica Neue","color":"#1F3DA8","bold":true,"alignment":"left"},"geometry":"rect"},
{"id":"sh/0fi94jmx","kind":"textbox","name":"Text 12","position":{"left":124.8,"top":374.4,"width":1075.2,"height":62.4},"text":"Test the same claim with a second tool or a controlled trace.","style":{"fontSize":21,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/1graxo3i","kind":"textbox","name":"Text 13","position":{"left":52.8,"top":451.2,"width":57.6,"height":43.2},"text":"05","style":{"fontSize":21.33,"typeface":"Helvetica Neue","color":"#1F3DA8","bold":true,"alignment":"left"},"geometry":"rect"},
{"id":"sh/edgr294r","kind":"textbox","name":"Text 14","position":{"left":124.8,"top":451.2,"width":1075.2,"height":62.4},"text":"Keep a human in the loop for any high-stakes finding (security vulnerabilities, critical logic).","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"},
{"id":"sh/fepsvelc","kind":"textbox","name":"Text 15","position":{"left":52.8,"top":528,"width":57.6,"height":43.2},"text":"06","style":{"fontSize":21.33,"typeface":"Helvetica Neue","color":"#1F3DA8","bold":true,"alignment":"left"},"geometry":"rect"},
{"id":"sh/oji9832t","kind":"textbox","name":"Text 16","position":{"left":124.8,"top":528,"width":1075.2,"height":62.4},"text":"Log the full agent trace so decisions can be audited later.","style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#1A1A1A","alignment":"left"},"geometry":"rect"}
]}
