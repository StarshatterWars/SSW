#include "/Plugin/VortexTunnel/CommonFunctions.ush"

struct HoneyComb
{
    float GetChecker(float2 pos)
    {
        float a = (step(0.5, frac(pos.x)) - 0.5);
        float b = (step(0.5, frac(pos.y)) - 0.5);
        return step(0.0, a * b);
    }

     float GetTile(float2 pos)
    {
        pos = frac(pos);
        float s = 1.5;
        pos.x *= s;
        float val = length(pos - float2(0.5 * s, 0.5));
        val = min(val, length(pos - float2(0.0, 0.0)));
        val = min(val, length(pos - float2(s, 0.0)));
        val = min(val, length(pos - float2(0.0, 1.0)));
        val = min(val, length(pos - float2( s, 1.0)));
        return val;
    }

    float GetHoneyCombTile(float2 uv, float time, float2 scale, float2 offset, float distortionscale, float distortionphase, float noisescale)
    {
        float distortion = distortionscale * sin((length(uv) + time) * PI * distortionphase);
        float2 pos = (uv) * (1.0 + 0.1 * distortion) + offset;

        float val = noisescale * GetTile(pos * scale);
        return val;
    }

};