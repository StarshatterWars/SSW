#include "/Plugin/VortexTunnel/CommonFunctions.ush"
 
struct PlasmaVortex
{

    VortexRandom VR;

    float GetGradientNoise(float3 p, float seed)
    {
        float3 i = floor(p);
        float3 f = frac(p);
        float3 a = f * f * (3.0 - 2.0 * f);

        float n000 = dot(VR.GetVortexNoise(i, seed), f);
        float n100 = dot(VR.GetVortexNoise(i + float3(1.0, 0.0, 0.0), seed), f - float3(1.0, 0.0, 0.0));
        float n010 = dot(VR.GetVortexNoise(i + float3(0.0, 1.0, 0.0), seed), f - float3(0.0, 1.0, 0.0));
        float n110 = dot(VR.GetVortexNoise(i + float3(1.0, 1.0, 0.0), seed), f - float3(1.0, 1.0, 0.0));
        float n001 = dot(VR.GetVortexNoise(i + float3(0.0, 0.0, 1.0), seed), f - float3(0.0, 0.0, 1.0));
        float n101 = dot(VR.GetVortexNoise(i + float3(1.0, 0.0, 1.0), seed), f - float3(1.0, 0.0, 1.0));
        float n011 = dot(VR.GetVortexNoise(i + float3(0.0, 1.0, 1.0), seed), f - float3(0.0, 1.0, 1.0));
        float n111 = dot(VR.GetVortexNoise(i + float3(1.0, 1.0, 1.0), seed), f - float3(1.0, 1.0, 1.0));
        
        return lerp(
            lerp(lerp(n000, n100, a.x), lerp(n010, n110, a.x), a.y),
            lerp(lerp(n001, n101, a.x), lerp(n011, n111, a.x), a.y), a.z);
    }
    
    float3 GetGradientNoise3D(float3 p, float3 seed)
    {
        float3 g = float3(GetGradientNoise(p, seed.x), GetGradientNoise(p, seed.y), GetGradientNoise(p, seed.z));
        float3 g2 = float3(
            GetGradientNoise(p.yzx + seed.xyz, seed.x),
            GetGradientNoise(p.zxy + seed.yzx, seed.y),
            GetGradientNoise(p.xyz + seed.zxy, seed.z)
        );
        return max(1.0 - abs((g + g2 * 0.5) * 1.5), float3(0,0,0));
    }
    
    float3 GetPlasmaNoise(float3 p, float3 coefficient, float3 roughness, float3 plasmapower1, float3 plasmapower2, int octaves, float3 seed)
    {
        float3 sum = float3(0,0,0);
        float3 y = float3(1,1,1);
        float3 amp = coefficient;
        float3 freq = float3(1,1,1);

        for(int i = 0; i < octaves; i++)
        {
            // Enhanced coordinate warping for more dynamic flow
            float3 warp = float3(
                sin(p.x * 1.7 + p.z * 1.2),
                cos(p.y * 1.4 + p.x * 1.6),
                sin(p.z * 1.8 + p.y * 1.3)
            ) * 0.15;

            float3 pos = p * freq + warp;
            float3 x = GetGradientNoise3D(pos, seed * (i + 1));
            
            // Enhanced plasma calculation
            float3 Plasma1 = pow(y + 0.5, plasmapower1) - 0.5;
            float3 Plasma2 = pow(x + 0.5, plasmapower2) - 0.5;
            
            // Add rotational flow
            float3 rotation = float3(
                sin(pos.z + seed.x),
                cos(pos.x + seed.y),
                sin(pos.y + seed.z)
            );
            
            sum += (Plasma1 * Plasma2 + rotation * 0.1) * amp;
            
            amp *= roughness;
            freq *= 2.0;
            y = lerp(y, x, 0.7);
        }

        return sum;
    }
};


