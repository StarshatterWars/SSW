// Narration keeps its authored timing. The shuttle holds for the opening
// exposition, then flies a route within its 250 m/s envelope to a stationary
// carrier. Departure and closing cards wait for the actual simulation dock event;
// no actor is teleported and no flight phase is forced.
event: { type: BeginScene, time: 0, message: "Training Introduction" }
event: { type: Hold, time: 0, param: 50, event_ship: "Proteus" }
event: { type: Camera, time: 0.01, param: 3, target: "Proteus", vec: (1,0.25,600) }
event: { type: Camera, time: 0.01, param: 5, vec: (0.06,0,0) }
event: { type: Display, time: 1, message: "Training Shuttle 'Proteus'" }
event: { type: Display, time: 3, message: "Borova Orbit" }

event: { type: Message, time: 5, sound: "Intro-1" }
event: { type: Message, time: 15, sound: "Intro-2" }

event: { type: Camera, time: 30, param: 3, target: "Archon", vec: (2,0.3,6000) }
event: { type: Camera, time: 30, param: 5, vec: (0.05,0,0) }
event: { type: Display, time: 30, message: "Task Force 3.7" }
event: { type: Display, time: 30, message: "CV-71 'Archon'" }
event: { type: Camera, time: 42, param: 3, target: "Proteus", vec: (2,0.2,600) }
event: { type: Camera, time: 42, param: 5, vec: (-0.05,0,0) }
event: { type: Message, time: 52, sound: "Intro-3" }

event: { type: Camera, time: 60, param: 3, target: "Archon", vec: (2,0.3,6000) }
event: { type: Camera, time: 60, param: 5, vec: (0.05,0,0) }
event: { type: Message, time: 60, sound: "Intro-4" }
event: { type: Display, time: 60, message: "Task Force 3.7" }
event: { type: Display, time: 60, message: "CV-71 'Archon'" }
event: { type: Camera, time: 70, param: 3, target: "Stalwart", vec: (2,0.25,4500) }
event: { type: Camera, time: 70, param: 5, vec: (0.05,0,0) }
event: { type: Display, time: 70, message: "CA-524 'Stalwart'" }
event: { type: Camera, time: 74, param: 3, target: "Gerson", vec: (2,0.25,3500) }
event: { type: Camera, time: 74, param: 5, vec: (0.05,0,0) }
event: { type: Display, time: 74, message: "DD/E-682 'Gerson'" }
event: { type: Camera, time: 78, param: 3, target: "Simmons", vec: (2,0.25,3500) }
event: { type: Camera, time: 78, param: 5, vec: (0.05,0,0) }
event: { type: Display, time: 78, message: "DD/E-687 'Simmons'" }

// Show the approach until capture; change focus before the recovered shuttle
// is retired by the normal hangar path.
event: { type: Camera, time: 85, param: 3, target: "Archon", vec: (2,0.15,6000) }
event: { type: Camera, time: 85, param: 5, vec: (-0.05,0,0) }
event: { type: Camera, trigger: Dock, trigger_ship: "Proteus", param: 3, target: "Archon", vec: (2,0.3,6000) }
event: { type: Camera, trigger: Dock, trigger_ship: "Proteus", param: 5, vec: (0.05,0,0) }

event: { type: Jump, trigger: Dock, trigger_ship: "Proteus", delay: 1, event_ship: "Simmons", target: "Tulkas" }
event: { type: Jump, trigger: Dock, trigger_ship: "Proteus", delay: 3, event_ship: "Gerson", target: "Tulkas" }
event: { type: Jump, trigger: Dock, trigger_ship: "Proteus", delay: 4, event_ship: "Stalwart", target: "Tulkas" }
event: { type: Jump, trigger: Dock, trigger_ship: "Proteus", delay: 5, event_ship: "Archon", target: "Tulkas" }
event: { type: Display, trigger: Dock, trigger_ship: "Proteus", delay: 6, image: "Black", fade: (1,15,1), rect: (0,0,0,0) }
event: { type: Display, trigger: Dock, trigger_ship: "Proteus", delay: 7, image: "StarshatterWars", fade: (1,11,1), rect: (0,0,0,0) }
event: { type: EndScene, trigger: Dock, trigger_ship: "Proteus", delay: 21, message: "Training Introduction End" }
event: { type: Exit }
