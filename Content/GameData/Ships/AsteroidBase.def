   design:           "Fusion Reactor",
   max_output:       90e3,

   loc:              (0, 0, 0),
   size:             48,
   hull_factor:      0.3,
   explosion:        7
}

// Deck coordinates are authored in legacy right/up/forward axes before ship scaling.
// The bay opens along local +Y in Unreal, 283 m from the actor origin.
// The recovery run ends inside the bay, with its nearest hoop at the threshold.
