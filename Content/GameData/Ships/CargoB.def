drive:
{
   type:             Fusion
   name:             "Fusion Drive"
   design:           "Fusion Drive"

   thrust:           2500
   scale:            4

   //--------------------------------------------------
   // Main engines
   // UE Space:
   // X = forward/back
   // Y = right/left
   // Z = up/down
   //--------------------------------------------------

   port:
   {
      name:          "Drive_Port"
      loc:           (-515, -82, 12)
      rot:           (0, 180, 0)

      flare_scale:   3.5
      trail_scale:   4.0

      color:         (120, 180, 255)

      intensity:     1.2
      audio:         1.0

      flare:         true
      trail:         true
   }

   port:
   {
      name:          "Drive_Starboard"
      loc:           (-515, 82, 12)
      rot:           (0, 180, 0)

      flare_scale:   3.5
      trail_scale:   4.0

      color:         (120, 180, 255)

      intensity:     1.2
      audio:         1.0

      flare:         true
      trail:         true
   }

   //--------------------------------------------------
   // Reactor / drive core
   //--------------------------------------------------

   loc:              (-320, 0, 40)

   size:             48
   hull_factor:      0.7
   explosion:        7
}

thruster:
{
   design:           "Thruster"

   loc:              (-120, 0, 40)
   size:             28
   hull_factor:      0.3

   //--------------------------------------------------
   // Port translation
   //--------------------------------------------------

    port_left:   {loc:( -60.0,-165.0, 28.0), rotation:(0.0,0.0,-90.0), fire:0x0041, name:Thruster_Port,       flare_scale:0.18, trail_scale:0.18}
    port_right:  {loc:( -60.0, 165.0, 28.0), rotation:(0.0,0.0, 90.0), fire:0x0082, name:Thruster_Starboard, flare_scale:0.18, trail_scale:0.18}

    port_top:    {loc:(-180.0,   0.0, 95.0), rotation:(0.0, 90.0,0.0), fire:0x0510, name:Thruster_Dorsal,    flare_scale:0.10, trail_scale:0.10}
    port_bottom: {loc:(-180.0,   0.0,-78.0), rotation:(0.0,-90.0,0.0), fire:0x0A20, name:Thruster_Ventral,   flare_scale:0.10, trail_scale:0.10}

    port_fore:   {loc:( 340.0,   0.0,  6.0), rotation:(0.0,0.0,0.0),   fire:0x0044, name:Thruster_Reverse,   flare_scale:0.18, trail_scale:0.18}

    port_aft:    {loc:(-500.0,   0.0, 18.0), rotation:(0.0,180.0,0.0), fire:0x0088, name:Thruster_Aft,      flare_scale:0.22, trail_scale:0.22}
}

navlight:
{
   design: "Navigation Lights"
   scale:  1.0
   period: 0.5

   //--------------------------------------------------
   // Port / Starboard
   //--------------------------------------------------

   light:
   {
      name: "Port"
      loc: (120.0, -170.0, 25.0)

      color: "red"

      intensity: 2200
      radius: 260

      mode: "blink"
      blink_interval: 0.50
      phase: 0.00
   }

   light:
   {
      name: "Starboard"
      loc: (120.0, 170.0, 25.0)

      color: "green"

      intensity: 2200
      radius: 260

      mode: "blink"
      blink_interval: 0.50
      phase: 0.25
   }

   //--------------------------------------------------
   // Dorsal / Ventral
   //--------------------------------------------------

