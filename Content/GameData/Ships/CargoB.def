   {
      name: "Docking_Port"
      loc: (-180.0, -65.0, -20.0)

      color: (1.0, 0.85, 0.45)

      intensity: 2600
      radius: 220

      mode: "blink"
      blink_interval: 1.00
      phase: 0.00
   }

   light:
   {
      name: "Docking_Starboard"
      loc: (-180.0, 65.0, -20.0)

      color: (1.0, 0.85, 0.45)

      intensity: 2600
      radius: 220

      mode: "blink"
      blink_interval: 1.00
      phase: 0.50
   }
}

