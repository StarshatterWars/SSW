<Window x:Class="FractalVerseAdmin.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/SSW.ico" Title="FractalVerse Admin — Fractal Dev Games" Width="1050" Height="760" MinWidth="900" MinHeight="650" Background="#0B1420" Foreground="#EAF4FF" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#24465A"/><Setter Property="Foreground" Value="#EAF4FF"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#122131"/><Setter Property="Foreground" Value="#C6DAE6"/><Setter Property="BorderBrush" Value="#2B495D"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border ClipToBounds="True"><Border.Background><ImageBrush ImageSource="Orion.png" Stretch="UniformToFill"/></Border.Background>
   <Border Background="#A009111D" Padding="22"><StackPanel><TextBlock Text="FRACTALVERSE ADMIN" FontSize="32" FontWeight="Bold"/><TextBlock Text="STARSHATTER WARS · Fractal Dev Games" FontSize="16" Foreground="#A9DCEE" Margin="0,6,0,0"/><TextBlock Text="Local universe monitoring · read-only" FontSize="12" Foreground="#E1C99E" Margin="0,10,0,0"/></StackPanel></Border>
  </Border>
  <DockPanel Grid.Row="1" Margin="0,16,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Select Server Folder…" Click="SelectFolder_Click"/><Button Content="Refresh" Click="Refresh_Click"/></StackPanel><TextBlock x:Name="ConnectionLabel" Text="DISCONNECTED" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#E1C99E"/></DockPanel>
  <Border Grid.Row="2" Background="#122131" Padding="16" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="UNIVERSE GMT" Foreground="#80D9F6" FontSize="11"/><TextBlock x:Name="ClockLabel" Text="—" Margin="0,6,0,0" FontSize="16"/><TextBlock x:Name="RevisionLabel" Text="No confirmed state" Foreground="#ACC4D5" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CLIENTS / UPTIME" Foreground="#80D9F6" FontSize="11"/><TextBlock x:Name="ClientsLabel" Text="— / 8" Margin="0,6,0,0" FontSize="16"/><TextBlock x:Name="UptimeLabel" Text="—" Foreground="#ACC4D5" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PERSISTENCE" Foreground="#80D9F6" FontSize="11"/><TextBlock x:Name="CheckpointLabel" Text="Unknown" Margin="0,6,0,0" FontSize="16"/><TextBlock x:Name="CheckpointTimeLabel" Text="—" Foreground="#ACC4D5" Margin="0,6,0,0"/></StackPanel></Grid></Border>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#122131" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="CONNECTED PLAYERS" Foreground="#80D9F6" FontSize="14" Margin="0,0,0,12"/><Grid Grid.Row="1" Background="#203747"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="PLAYER" Margin="8"/><TextBlock Grid.Column="1" Text="PING" Margin="8"/></Grid><ListBox x:Name="PlayersGrid" Grid.Row="2" Background="#172B3B" Foreground="#EAF4FF" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListBox.ItemTemplate><DataTemplate><Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Ping}"/></Grid></DataTemplate></ListBox.ItemTemplate>
</ListBox></Grid></Border>
   <Border Grid.Column="2" Background="#122131" Padding="16"><StackPanel><TextBlock Text="SIMULATION / PROCESS" Foreground="#80D9F6" FontSize="14" Margin="0,0,0,12"/><TextBlock x:Name="EconomyLabel" Text="No confirmed economy state" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBlock x:Name="ProcessLabel" Text="No local process telemetry" TextWrapping="Wrap" Foreground="#ACC4D5" Margin="0,0,0,14"/><TextBlock Text="This app monitors the server. It does not own or alter game state." Foreground="#E1C99E" TextWrapping="Wrap" FontSize="12"/><Button Content="View Recent Log" Click="Log_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
  </Grid>
  <TextBlock x:Name="SourceLabel" Grid.Row="4" Foreground="#ACC4D5" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
 </Grid>
</Window>
